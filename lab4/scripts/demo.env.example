# Скопируй в demo.env и подставь свои значения.
# На Mac: cp scripts/demo.env.example scripts/demo.env

# Имя из `tailscale status` или MagicDNS, либо IP `100.x.y.z`
DEMO_HOST=your-pc-name

# Windows-пользователь (как в C:\Users\...)
DEMO_USER=User

# Путь к lab4 на Windows в стиле OpenSSH (/d/ = диск D:)
DEMO_DIR=/d/CUDA/lab4

# Аргументы lab4
DEMO_ARGS='--n 1000000 --mode all --gpu-variant all --reps 1'
