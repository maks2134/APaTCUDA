# Скопируй в demo.env и подставь свои значения.
# На Mac: cp scripts/demo.env.example scripts/demo.env

# Имя из `tailscale status` или MagicDNS, либо IP `100.x.y.z`
DEMO_HOST=your-pc-name

# Windows-пользователь (как в C:\Users\...)
DEMO_USER=User

# Путь к lab3 на Windows в стиле OpenSSH (/d/ = диск D:)
DEMO_DIR=/d/CUDA/lab3

# Аргументы lab3
DEMO_ARGS='--k 2048 --m 2048 --mode all --gpu-variant all --reps 1 --save-image'

# Куда на Mac класть panel PNG (пусто = не качать)
DEMO_PNG_OUT="$HOME/Desktop/lab3_panel.png"
